{
  "//": "热点数据源配置。type 支持 aihot / follow-builders / hackernews / github / rss，都不需要 API key。",
  "//2": "AI 内容默认用 AIHOT + Zara Zhang 维护的 follow-builders；其他垂类可换成自己的 RSS。",
  "sources": [
    {
      "id": "aihot",
      "type": "aihot",
      "label": "AI HOT（all + selected 合并去重）",
      "modes": ["all", "selected"],
      "takes": { "all": 100, "selected": 50 },
      "excerpt_limit": 1000,
      "enabled": true
    },
    {
      "id": "follow-builders-x",
      "type": "follow-builders",
      "feed": "x",
      "label": "follow-builders · X",
      "limit": 50,
      "excerpt_limit": 1000,
      "enabled": true
    },
    {
      "id": "follow-builders-blogs",
      "type": "follow-builders",
      "feed": "blogs",
      "label": "follow-builders · Blogs",
      "limit": 20,
      "excerpt_limit": 1000,
      "enabled": true
    },
    {
      "id": "follow-builders-podcasts",
      "type": "follow-builders",
      "feed": "podcasts",
      "label": "follow-builders · Podcasts",
      "limit": 10,
      "excerpt_limit": 1000,
      "enabled": true
    },
    { "id": "hackernews", "type": "hackernews", "label": "Hacker News 首页", "limit": 20, "enabled": false },
    { "id": "github", "type": "github", "label": "GitHub 新星项目", "limit": 15, "days": 7, "enabled": false },
    {
      "id": "example-rss",
      "type": "rss",
      "label": "示例 RSS 源（换成你自己的）",
      "url": "https://hnrss.org/frontpage",
      "limit": 10,
      "enabled": false
    }
  ]
}
